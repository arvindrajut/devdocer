# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: chat model (default gpt-5.4-mini) and embedding model (default text-embedding-3-small)
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: set to 1 to run without an API key (deterministic fake embeddings and answers, for local UI work and tests)
DEVDOCER_FAKE_AI=
